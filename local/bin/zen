#!/usr/bin/env bash

if command -v zen-browser >/dev/null 2>&1; then
    exec zen-browser "$@"
elif command -v zen-twilight >/dev/null 2>&1; then
    exec zen-twilight "$@"
elif command -v zen-beta >/dev/null 2>&1; then
    exec zen-beta "$@"
else
    echo "Neither zen-browser, zen-twilight nor zen-beta was found." >&2
    exit 1
fi
