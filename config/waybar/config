{
  "layer": "top",
  "position": "top",
  "height": 10,
  "margin-top": 2,
  "margin-bottom": 2,
  "margin-left": 2,
  "margin-right": 2,
  "spacing": 8,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "network",
    "custom/ethernet",
    "cpu",
    "memory",
    "temperature",
    "wireplumber",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "disable-scroll": true,
    "sort-by-number": true,
    "persistent-workspaces": {
        "HDMI-A-1": [2, 4, 6, 8, 10 ],
        "DP-1": [ 1, 3, 5, 7, 9]
    }
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S | %d}",
    "tooltip-format": "{:%H:%M:%S | %A, %d.%m.%Y}"
  },

  "wireplumber": {
    "scroll-step": 2,
    "format": "{icon} {volume}% {format_source}",
    "format-source": " {volume}%",
    "format-muted": "󰖁 muted {format_source}",
    "format-icons": {
      "headphones": "󰋋",
      "handsfree": "󰋋",
      "headset": "󰋋",
      "phone": "󰏲",
      "portable": "󰄟",
      "car": "󰄋",
      "default": ["󰕿","󰖀","󰕾"]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "wpctl set-sink-volume @DEFAULT_SINK@ -2%"
  },

  "custom/ethernet": {
      "exec": "~/.config/waybar/scripts/external.ip",
      "format": "🌍 {text}",
      "interval": 50,
      "return-type": "json",
      "tooltip": true,
  },

  "network": {
    "format-wifi": " {essid} {signalStrength}%",
    "tooltip-format-wifi": "{ifname} • Up: {bandwidthUpBytes}  Down: {bandwidthDownBytes}",
    "format-ethernet": "", 
    "format-disconnected": "󰖪",
    "tooltip-format-disconnected": "No connection",
    "interval": 3,
    "on-click": "nm-connection-editor",
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "states": {
      "good": 0,
      "warning": 65,
      "critical": 80
    },
    "on-click": "ghostty -e btop",
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "states": {
      "good": 0,
      "warning": 65,
      "critical": 80
    },
    "on-click": "ghostty -e btop",
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "{icon} {temperatureC}°C",
    "tooltip": true,
    "format-icons": ["", "", ""],
    "tooltip": true,
    "warning-threshold": 0,
    "critical-threshold": 70,
    "format-critical": " {temperatureC}°C",
    "interval": 1,
    "on-click": "ghostty -e btop",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "backlight": {
      "device": "acpi_video1",
      "format": "{percent}% {icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
  },

  "battery": {
      "states": {
          "good": 95,
          "warning": 30,
          "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-full": "{capacity}% {icon}",
      "format-charging": "{capacity}% 󰂄",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
      "format-icons": ["", "", "", "", ""]
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  }
}

